# Safe deployment environment template
#
# Copy to .env only for local/operator use, replace every placeholder with your
# own value, and never commit the populated file.

# Immutable images required by docker-compose.prod.yml.
GATEWAY_IMAGE=ghcr.io/poojakira/unified-ml-security-platform@sha256:replace-with-real-digest
MCP_GATEWAY_IMAGE=ghcr.io/poojakira/mcp-agent-security-gateway@sha256:replace-with-real-digest
LLM_REDTEAM_IMAGE=ghcr.io/poojakira/llm-redteam-framework@sha256:replace-with-real-digest
DATASET_POISON_IMAGE=ghcr.io/poojakira/dataset-poisoning-detector@sha256:replace-with-real-digest
MODEL_PRIVACY_IMAGE=ghcr.io/poojakira/model-privacy-attacks@sha256:replace-with-real-digest

# Generate/use your own secrets. These values are placeholders only.
GATEWAY_API_KEY=replace-with-your-own-strong-random-value
MCP_GATEWAY_API_KEY=replace-with-your-own-strong-random-value
LLM_REDTEAM_API_KEY=replace-with-your-own-strong-random-value
DATASET_POISON_API_KEY=replace-with-your-own-strong-random-value
MODEL_PRIVACY_API_KEY=replace-with-your-own-strong-random-value

MCP_ALLOWED_SERVERS=github

# Absolute host path to a known-clean NPZ baseline for the dataset detector.
DATASET_BASELINE_FILE=/absolute/path/to/known-clean-baseline.npz

# Optional override. The production compose file otherwise uses its internal Redis.
# POISON_REDIS_URL=redis://redis:6379/0
